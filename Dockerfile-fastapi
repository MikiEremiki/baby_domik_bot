FROM python:3.12-slim as base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT="/usr/local/"

WORKDIR /app

RUN pip install uv

RUN --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --frozen --extra fastapi

COPY src/__init__.py ./src/
COPY src/api/__init__.py ./src/api/
COPY src/api/web ./src/api/web
COPY src/api/yookassa_connect.py src/api/gspread_pub.py src/api/receipt_service.py ./src/api/
COPY src/db ./src/db
COPY src/settings ./src/settings
COPY src/log ./src/log
COPY src/utilities ./src/utilities
COPY templates ./templates
COPY static ./static
